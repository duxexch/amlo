# AMLO dedicated high-power single-server production template
# Copy to production .env and replace all REPLACE_* placeholders before go-live.

NODE_ENV=production
PORT=3000

# Domain
DOMAIN=mrco.live
CORS_ORIGIN=https://mrco.live,https://www.mrco.live

# Core secrets
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ENCRYPTION_SECRET=REPLACE_WITH_64_HEX
TURN_SECRET=REPLACE_WITH_STRONG_TURN_SECRET

# Database + Redis
DATABASE_URL=postgresql://ablox_admin:REPLACE_PASSWORD@localhost:5432/ablox
DB_POOL_MAX=35
DB_POOL_MIN=8
DB_POOL_MAX_USES=7500
DB_SSL=false
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@localhost:6379

# Worker/process model
CLUSTER_WORKERS=4
LOG_LEVEL=info

# Socket + write controls
SOCKET_MAX_CONNECTIONS_PER_IP=350
SOCKET_CONNECTION_WINDOW_MS=60000
SOCKET_WEBSOCKET_ONLY=true
SOCIAL_WRITE_LIMIT_MAX=90
SOCIAL_WRITE_LIMIT_WINDOW_MS=60000
SOCIAL_WRITE_LIMIT_DISABLED=false

# Streaming controls
STREAM_MAX_PARTICIPANTS_PER_ROOM=220
STREAM_ROOM_EMPTY_TIMEOUT_SEC=300
STREAM_FOLLOWER_NOTIFY_LIMIT=1000
STREAM_AUTOSTART_BATCH_LIMIT=40

# LiveKit + TURN
LIVEKIT_PUBLIC_URL=wss://lk.mrco.live
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_IP_ADDRESSES=
TURN_EXTERNAL_IP=REPLACE_WITH_PUBLIC_IPV4
TURN_TLS_LISTEN_PORT=5349
LIVEKIT_TURN_SERVERS=turn:turn.mrco.live:3478?transport=udp,turn:turn.mrco.live:3478?transport=tcp,turns:turn.mrco.live:5349?transport=tcp
LIVEKIT_STUN_SERVERS=stun:stun.l.google.com:19302,stun:turn.mrco.live:3478

# Mobile artifact publication
APP_DOWNLOAD_ENABLED=true
APP_DOWNLOAD_DOMAIN=https://mrco.live
APK_ENABLED=true
APK_URL=https://mrco.live/download/ablox.apk
APK_VERSION=REPLACE_APK_VERSION
APK_BUILD=REPLACE_APK_BUILD
APK_SHA256=REPLACE_APK_SHA256
APK_SIZE_BYTES=REPLACE_APK_SIZE_BYTES
AAB_ENABLED=true
AAB_URL=https://mrco.live/download/ablox.aab
AAB_VERSION=REPLACE_AAB_VERSION
AAB_BUILD=REPLACE_AAB_BUILD
AAB_SHA256=REPLACE_AAB_SHA256
AAB_SIZE_BYTES=REPLACE_AAB_SIZE_BYTES

# OTP + SMTP (required for email OTP mode)
OTP_ENABLED=true
OTP_PROVIDER=email
OTP_EMAIL_ENABLED=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@mrco.live
SMTP_PASS=REPLACE_WITH_EMAIL_PASSWORD
SMTP_SENDER_NAME=Vixo
SMTP_SENDER_EMAIL=info@mrco.live
