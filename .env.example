# ══════════════════════════════════════════════════════════════
# Ablox — Environment Variables Template
# Copy this file to .env and fill in your values
# In Docker: DATABASE_URL and REDIS_URL are overridden by docker-compose.yml
# ══════════════════════════════════════════════════════════════

# ── Domain (used by Traefik for SSL) ──
DOMAIN=vixo.uno
ACME_EMAIL=info@vixo.uno

# ── Database ──
POSTGRES_DB=ablox
POSTGRES_USER=ablox_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ablox_admin:CHANGE_ME@localhost:5432/ablox

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_URL=redis://:CHANGE_ME@localhost:6379

# ── Session (generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ──
SESSION_SECRET=CHANGE_ME_64_CHAR_RANDOM

# ── Server ──
NODE_ENV=development
PORT=3000
APP_PORT=3000
CLUSTER_WORKERS=2

# ── Database Pool ──
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_MAX_USES=7500

# ── Socket Scale Tuning ──
# Per-IP connection cap in Socket.IO connection window
SOCKET_MAX_CONNECTIONS_PER_IP=200
# Window in ms for the per-IP cap
SOCKET_CONNECTION_WINDOW_MS=60000
# Set true in cluster mode without sticky sessions (websocket-only transport)
SOCKET_WEBSOCKET_ONLY=false

# ── Social Write Rate Limit ──
# Default: 60 writes / 60s per IP on /api/social (POST/PUT/PATCH/DELETE)
SOCIAL_WRITE_LIMIT_MAX=60
SOCIAL_WRITE_LIMIT_WINDOW_MS=60000
# Only for controlled load tests in isolated environments
SOCIAL_WRITE_LIMIT_DISABLED=false

# ── Stream Capacity Control (Single Server Production) ──
# Max viewers allowed per LiveKit stream room. Reduce to protect CPU and bandwidth.
STREAM_MAX_PARTICIPANTS_PER_ROOM=120
# LiveKit room auto-cleanup when empty (seconds)
STREAM_ROOM_EMPTY_TIMEOUT_SEC=300
# Max followers to notify per stream start event
STREAM_FOLLOWER_NOTIFY_LIMIT=500
# Scheduled streams auto-start batch per interval
STREAM_AUTOSTART_BATCH_LIMIT=20

# ── Logging (trace|debug|info|warn|error|fatal) ──
LOG_LEVEL=info

# ── JWT (generate same as session secret) ──
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM
JWT_EXPIRES_IN=7d

# ── CORS (REQUIRED in production) ──
CORS_ORIGIN=https://vixo.uno

# ── WebRTC / LiveKit / TURN ──
# LiveKit server API credentials (must match config/livekit.yaml keys)
LIVEKIT_API_KEY=ablox_livekit_key
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET
# Public LiveKit endpoint used by clients
LIVEKIT_PUBLIC_URL=wss://lk.vixo.uno
# Internal LiveKit URL (container-to-container). Keep default for Docker Compose.
LIVEKIT_URL=ws://livekit:7880
# Required for TURN auth token generation
TURN_SECRET=CHANGE_ME_TURN_SECRET
# Optional explicit public IP override for LiveKit ICE (recommended on production)
LIVEKIT_IP_ADDRESSES=
# TURN URIs announced by LiveKit to clients
# Keep these aligned with coturn listening ports (3478 + TURN_TLS_LISTEN_PORT)
LIVEKIT_TURN_SERVERS=turn:turn.vixo.uno:3478?transport=udp,turn:turn.vixo.uno:3478?transport=tcp,turns:turn.vixo.uno:5349?transport=tcp
# Optional fallback for highly restrictive networks:
# add turns:turn.vixo.uno:443?transport=tcp only when 443 is dedicated to TURN on a separate endpoint/IP.
# LIVEKIT_TURN_SERVERS=turn:turn.vixo.uno:3478?transport=udp,turn:turn.vixo.uno:3478?transport=tcp,turns:turn.vixo.uno:5349?transport=tcp,turns:turn.vixo.uno:443?transport=tcp
# Keep TURN credentials in sync with coturn auth secret setup
LIVEKIT_TURN_USERNAME=ablox
LIVEKIT_TURN_PASSWORD=CHANGE_ME_LIVEKIT_SECRET
# Optional custom STUN list (comma-separated)
LIVEKIT_STUN_SERVERS=stun:stun.l.google.com:19302,stun:turn.vixo.uno:3478
# Public server IPv4 for TURN external mapping
TURN_EXTERNAL_IP=
# Optional TURN TLS (recommended for restrictive networks)
# If cert/key exist, coturn enables TURNS on TURN_TLS_LISTEN_PORT.
TURN_CERTS_DIR=/etc/letsencrypt
TURN_TLS_CERT_FILE=/etc/letsencrypt/live/turn.vixo.uno/fullchain.pem
TURN_TLS_KEY_FILE=/etc/letsencrypt/live/turn.vixo.uno/privkey.pem
TURN_TLS_LISTEN_PORT=5349

# ── Encryption (AES-256-GCM key — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ──
# REQUIRED in production — server will NOT start without it
ENCRYPTION_SECRET=CHANGE_ME_64_HEX_CHARS

# ── Admin defaults ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── SMTP / Email (OTP & Password Reset) ──
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@vixo.uno
SMTP_PASS=CHANGE_ME_EMAIL_PASSWORD
SMTP_SENDER_NAME=Ablox
SMTP_SENDER_EMAIL=info@vixo.uno

# ── TWA / Android App (PWABuilder) ──
# SHA-256 fingerprint from your signing key (keytool or PWABuilder)
# TWA_SHA256_FINGERPRINT=AA:BB:CC:...
# SHA-256 from Google Play App Signing (if uploaded to Play Store)
# PLAY_SHA256_FINGERPRINT=DD:EE:FF:...
# Android package name
TWA_PACKAGE_NAME=live.vixo.twa

# ── Apple iOS App (Universal Links) ──
# Your Apple Developer Team ID
# APPLE_TEAM_ID=XXXXXXXXXX
# Your iOS app bundle identifier
# APPLE_BUNDLE_ID=app.ablox.ios
