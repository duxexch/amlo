# AMLO production-tuned baseline (local benchmark validated)
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgresql://ablox_admin:REPLACE_PASSWORD@localhost:5432/ablox
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_MAX_USES=7500
DB_SSL=false

# Redis
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@localhost:6379

# Socket scaling
SOCKET_MAX_CONNECTIONS_PER_IP=200
SOCKET_CONNECTION_WINDOW_MS=60000
# Enable when cluster is used without sticky sessions
SOCKET_WEBSOCKET_ONLY=true

# Cluster
CLUSTER_WORKERS=2

# Stream capacity controls (single-server baseline)
STREAM_MAX_PARTICIPANTS_PER_ROOM=120
STREAM_ROOM_EMPTY_TIMEOUT_SEC=300
STREAM_FOLLOWER_NOTIFY_LIMIT=500
STREAM_AUTOSTART_BATCH_LIMIT=20

# Logging profile for production stability
LOG_LEVEL=info

# Browser and mobile origin policy
CORS_ORIGIN=https://mrco.live,https://www.mrco.live

# LiveKit + TURN universal compatibility (browsers + APK/AAB over mixed networks)
LIVEKIT_PUBLIC_URL=wss://lk.mrco.live
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_IP_ADDRESSES=
TURN_EXTERNAL_IP=REPLACE_WITH_PUBLIC_IPV4
TURN_TLS_LISTEN_PORT=5349
LIVEKIT_TURN_SERVERS=turn:turn.mrco.live:3478?transport=udp,turn:turn.mrco.live:3478?transport=tcp,turns:turn.mrco.live:5349?transport=tcp
# Use only with dedicated TURN endpoint/IP different from web TLS endpoint
# LIVEKIT_TURN_SERVERS=turn:turn.mrco.live:3478?transport=udp,turn:turn.mrco.live:3478?transport=tcp,turns:turn.mrco.live:5349?transport=tcp,turns:turn.mrco.live:443?transport=tcp
LIVEKIT_STUN_SERVERS=stun:stun.l.google.com:19302,stun:turn.mrco.live:3478

# Required secrets
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ENCRYPTION_SECRET=REPLACE_WITH_64_HEX
TURN_SECRET=REPLACE_WITH_STRONG_TURN_SECRET

# Signing / Official mobile artifacts
SIGNING_KEYSTORE_PATH=signing/ablox-release.keystore
SIGNING_KEY_ALIAS=ablox
SIGNING_STORE_PASSWORD=REPLACE_WITH_STRONG_SIGNING_PASSWORD
SIGNING_KEY_PASSWORD=REPLACE_WITH_STRONG_SIGNING_PASSWORD
SIGNING_CREATE_IF_MISSING=0
SIGNING_DNAME=CN=Ablox,OU=Mobile,O=Ablox,L=Riyadh,S=Riyadh,C=SA

# App Download publication metadata
APP_DOWNLOAD_ENABLED=true
APP_DOWNLOAD_DOMAIN=https://mrco.live
APK_ENABLED=true
APK_URL=https://mrco.live/download/ablox.apk
APK_VERSION=REPLACE_APK_VERSION
APK_BUILD=REPLACE_APK_BUILD
APK_SHA256=REPLACE_APK_SHA256
APK_SIZE_BYTES=0
AAB_ENABLED=true
AAB_URL=https://mrco.live/download/ablox.aab
AAB_VERSION=REPLACE_AAB_VERSION
AAB_BUILD=REPLACE_AAB_BUILD
AAB_SHA256=REPLACE_AAB_SHA256
AAB_SIZE_BYTES=0

# Social providers bootstrap
SOCIAL_GOOGLE_ENABLED=true
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_APPLE_ENABLED=true
SOCIAL_APPLE_SERVICE_ID=
SOCIAL_APPLE_TEAM_ID=
SOCIAL_APPLE_KEY_ID=
SOCIAL_FACEBOOK_ENABLED=false
SOCIAL_FACEBOOK_APP_ID=
SOCIAL_FACEBOOK_APP_SECRET=
SOCIAL_TWITTER_ENABLED=false
SOCIAL_TWITTER_API_KEY=
SOCIAL_TWITTER_API_SECRET=
SOCIAL_TIKTOK_ENABLED=false
SOCIAL_TIKTOK_CLIENT_KEY=
SOCIAL_TIKTOK_CLIENT_SECRET=
SOCIAL_SNAPCHAT_ENABLED=false
SOCIAL_SNAPCHAT_CLIENT_ID=
SOCIAL_SNAPCHAT_CLIENT_SECRET=
SOCIAL_INSTAGRAM_ENABLED=false
SOCIAL_INSTAGRAM_APP_ID=
SOCIAL_INSTAGRAM_APP_SECRET=
SOCIAL_HUAWEI_ENABLED=false
SOCIAL_HUAWEI_APP_ID=
SOCIAL_HUAWEI_APP_SECRET=

# OTP + SMS providers bootstrap
OTP_ENABLED=true
OTP_PROVIDER=email
OTP_EMAIL_ENABLED=true
OTP_SMS_ENABLED=false
SMS_PROVIDER=twilio
SMS_PHONE_NUMBER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
OTP_CODE_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_MINUTES=5

# SMTP / Email (OTP + password reset)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@vixo.uno
SMTP_PASS=REPLACE_WITH_EMAIL_PASSWORD
SMTP_SENDER_NAME=Vixo
SMTP_SENDER_EMAIL=info@vixo.uno

# Payment gateways bootstrap
GATEWAY_STRIPE_ENABLED=true
GATEWAY_STRIPE_MODE=live
GATEWAY_STRIPE_PUBLIC_KEY=
GATEWAY_STRIPE_SECRET_KEY=
GATEWAY_STRIPE_WEBHOOK_SECRET=
GATEWAY_PAYPAL_ENABLED=false
GATEWAY_PAYPAL_MODE=live
GATEWAY_PAYPAL_CLIENT_ID=
GATEWAY_PAYPAL_CLIENT_SECRET=
GATEWAY_PAYPAL_WEBHOOK_ID=
GATEWAY_PAYMOB_ENABLED=false
GATEWAY_PAYMOB_MODE=live
GATEWAY_PAYMOB_API_KEY=
GATEWAY_PAYMOB_INTEGRATION_ID=
GATEWAY_PAYMOB_IFRAME_ID=
GATEWAY_PAYMOB_HMAC_SECRET=
GATEWAY_MYFATOORAH_ENABLED=false
GATEWAY_MYFATOORAH_MODE=live
GATEWAY_MYFATOORAH_API_TOKEN=
GATEWAY_MYFATOORAH_WEBHOOK_SECRET=
GATEWAY_TAP_ENABLED=false
GATEWAY_TAP_MODE=live
GATEWAY_TAP_SECRET_KEY=
GATEWAY_TAP_PUBLIC_KEY=
GATEWAY_TAP_WEBHOOK_SECRET=
GATEWAY_MOYASAR_ENABLED=false
GATEWAY_MOYASAR_MODE=live
GATEWAY_MOYASAR_SECRET_KEY=
GATEWAY_MOYASAR_PUBLISHABLE_KEY=
GATEWAY_MOYASAR_WEBHOOK_SECRET=
